# Optional: send the knowledge-tracing steps to the engine service in ../backend.
# Leave unset to use the in-browser engine (this is what the deployed demo does).
# VITE_API_URL=http://localhost:8000
# Optional: which engine model the service uses for this site. Leave unset for the service's default (improved).
# VITE_ENGINE_MODEL=baseline
# Optional: the key of a service started with CIRCUIT_COACH_API_KEY (sent as X-API-Key).
# VITE_API_KEY=
