{
  "openapi": "3.1.0",
  "info": {
    "title": "Circuit Coach engine",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/concepts": {
      "get": {
        "summary": "Concepts",
        "description": "The concept graph, modules and lessons the engine knows about.",
        "operationId": "concepts_v1_concepts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/onboarding": {
      "post": {
        "summary": "Onboarding",
        "description": "Seed a new learner's model from their stated experience and the placement quiz.",
        "operationId": "onboarding_v1_onboarding_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "baseline",
                    "improved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Engine model for this request: baseline or improved. Defaults to the service setting",
              "title": "Model"
            },
            "description": "Engine model for this request: baseline or improved. Defaults to the service setting"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quiz-result": {
      "post": {
        "summary": "Quiz Result",
        "description": "Update the model from a finished quick check and return the single recommendation.\n\nWhen `recheck_concept` is set (a spaced re-check was failed) the recommendation is marked\nas a repeat gap and uses a lesson the learner has not tried.",
        "operationId": "quiz_result_v1_quiz_result_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "baseline",
                    "improved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Engine model for this request: baseline or improved. Defaults to the service setting",
              "title": "Model"
            },
            "description": "Engine model for this request: baseline or improved. Defaults to the service setting"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/got-it": {
      "post": {
        "summary": "Got It",
        "description": "The learner said \"Got it!\": apply a learning step. Mastery is confirmed by a later re-check.",
        "operationId": "got_it_v1_got_it_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "baseline",
                    "improved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Engine model for this request: baseline or improved. Defaults to the service setting",
              "title": "Model"
            },
            "description": "Engine model for this request: baseline or improved. Defaults to the service setting"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GotItRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GotItResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/marked-answer": {
      "post": {
        "summary": "Marked Answer",
        "description": "A trainer marked a short answer: trace it as partial credit and recheck its concepts.\n\nShort answers wait for a trainer, so they reach the model after the quick check. The\nrecommendation covers only the marked answer's concepts (null when they look fine).",
        "operationId": "marked_answer_v1_marked_answer_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "baseline",
                    "improved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Engine model for this request: baseline or improved. Defaults to the service setting",
              "title": "Model"
            },
            "description": "Engine model for this request: baseline or improved. Defaults to the service setting"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkedAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/barabari/quiz-attempt": {
      "post": {
        "summary": "Barabari Quiz Attempt",
        "description": "Trace one attempt from Barabari's LMS and return the recommendation and the quiz score.",
        "operationId": "barabari_quiz_attempt_v1_barabari_quiz_attempt_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "baseline",
                    "improved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Engine model for this request: baseline or improved. Defaults to the service setting",
              "title": "Model"
            },
            "description": "Engine model for this request: baseline or improved. Defaults to the service setting"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BarabariAttemptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarabariAttemptResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/learners/{learner_id}/state": {
      "get": {
        "summary": "Learner State",
        "description": "A learner's saved state (storage must be on: CIRCUIT_COACH_DB).",
        "operationId": "learner_state_v1_learners__learner_id__state_get",
        "parameters": [
          {
            "name": "learner_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Learner Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BarabariAnswer": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "selected_option_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Option Id"
          },
          "text_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text Answer"
          },
          "points_earned": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Points Earned",
            "description": "Instructor's mark for a short answer; null while awaiting review"
          }
        },
        "type": "object",
        "required": [
          "question_id"
        ],
        "title": "BarabariAnswer"
      },
      "BarabariAttempt": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "quiz_id": {
            "type": "string",
            "title": "Quiz Id"
          },
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt Number",
            "default": 1
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitted At"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/BarabariAnswer"
            },
            "type": "array",
            "title": "Answers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "quiz_id",
          "student_id",
          "answers"
        ],
        "title": "BarabariAttempt",
        "description": "One row of `quiz_attempts` (the shape we assume until Barabari shares theirs)."
      },
      "BarabariAttemptRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/StateModel"
          },
          "quiz": {
            "$ref": "#/components/schemas/BarabariQuiz"
          },
          "attempt": {
            "$ref": "#/components/schemas/BarabariAttempt"
          },
          "tags": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BarabariTags"
              },
              {
                "type": "null"
              }
            ],
            "description": "Concept tags; defaults to the service's barabari_tags.json"
          },
          "now": {
            "type": "integer",
            "title": "Now",
            "default": 0
          },
          "learner_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Id",
            "description": "Defaults to the attempt's student_id when storage is on"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Defaults to the attempt id: the same attempt sent twice is applied once"
          }
        },
        "type": "object",
        "required": [
          "state",
          "quiz",
          "attempt"
        ],
        "title": "BarabariAttemptRequest"
      },
      "BarabariAttemptResponse": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/StateModel"
          },
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendationModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "$ref": "#/components/schemas/BarabariScore"
          },
          "assessed_concepts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assessed Concepts"
          }
        },
        "type": "object",
        "required": [
          "state",
          "recommendation",
          "score",
          "assessed_concepts"
        ],
        "title": "BarabariAttemptResponse"
      },
      "BarabariOption": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "option_text": {
            "type": "string",
            "title": "Option Text",
            "default": ""
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "BarabariOption"
      },
      "BarabariQuestion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "question_text": {
            "type": "string",
            "title": "Question Text",
            "default": ""
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer"
            ],
            "title": "Question Type"
          },
          "points": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Points"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "default": ""
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/BarabariOption"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "id",
          "question_type",
          "points"
        ],
        "title": "BarabariQuestion"
      },
      "BarabariQuiz": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "unit_id": {
            "type": "string",
            "title": "Unit Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "passing_score": {
            "type": "number",
            "title": "Passing Score",
            "default": 60
          },
          "max_score": {
            "type": "number",
            "title": "Max Score",
            "default": 100
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/BarabariQuestion"
            },
            "type": "array",
            "minItems": 1,
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "unit_id",
          "questions"
        ],
        "title": "BarabariQuiz",
        "description": "A quiz as stored in Barabari's `quizzes` and `quiz_questions` tables."
      },
      "BarabariScore": {
        "properties": {
          "points": {
            "type": "number",
            "title": "Points"
          },
          "max_score": {
            "type": "number",
            "title": "Max Score"
          },
          "percent": {
            "type": "number",
            "title": "Percent"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "awaiting_review_points": {
            "type": "number",
            "title": "Awaiting Review Points",
            "description": "Points of short answers not marked yet; they are left out of the model"
          },
          "answers_revealed": {
            "type": "boolean",
            "title": "Answers Revealed",
            "description": "True from the third attempt, when Barabari shows correct answers"
          }
        },
        "type": "object",
        "required": [
          "points",
          "max_score",
          "percent",
          "passed",
          "awaiting_review_points",
          "answers_revealed"
        ],
        "title": "BarabariScore"
      },
      "BarabariTags": {
        "properties": {
          "units": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Units",
            "description": "unit_id to concept ids"
          },
          "questions": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Questions",
            "description": "question id (or quiz id/question id) to concept ids; wins over the unit"
          }
        },
        "type": "object",
        "title": "BarabariTags"
      },
      "ConceptModel": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/TextModel"
          },
          "prereqs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prereqs"
          }
        },
        "type": "object",
        "required": [
          "name",
          "prereqs"
        ],
        "title": "ConceptModel"
      },
      "ConceptsResponse": {
        "properties": {
          "concepts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ConceptModel"
            },
            "type": "object",
            "title": "Concepts"
          },
          "modules": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModuleModel"
            },
            "type": "object",
            "title": "Modules"
          },
          "content": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Content",
            "description": "Lesson ids per concept, in recommendation order"
          }
        },
        "type": "object",
        "required": [
          "concepts",
          "modules",
          "content"
        ],
        "title": "ConceptsResponse"
      },
      "EventModel": {
        "properties": {
          "concept_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Concept Tags"
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "unsure": {
            "type": "boolean",
            "title": "Unsure",
            "description": "The learner chose \"I'm not sure\"",
            "default": false
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer"
            ],
            "title": "Question Type",
            "description": "Barabari question type; sets the chance of a lucky guess",
            "default": "multiple_choice"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Partial credit from 0 to 1 (points earned / points). Overrides is_correct"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt Number",
            "description": "1 for the first try at this quiz; retakes count for less",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "concept_tags",
          "is_correct"
        ],
        "title": "EventModel"
      },
      "GotItRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/StateModel"
          },
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "content_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Id",
            "description": "The lesson the learner just finished; it is added to `tried` so a repeat gap gets a different one"
          },
          "learner_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Id",
            "description": "With storage on: load this learner's saved state when `state` is empty, and save the result"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "With storage on: a resent request with the same id for the same learner returns the saved response instead of being applied twice"
          }
        },
        "type": "object",
        "required": [
          "state",
          "concept_id"
        ],
        "title": "GotItRequest"
      },
      "GotItResponse": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/StateModel"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "GotItResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "parameters": {
            "type": "string",
            "enum": [
              "fitted",
              "hand-set"
            ],
            "title": "Parameters"
          },
          "model": {
            "type": "string",
            "enum": [
              "baseline",
              "improved"
            ],
            "title": "Model",
            "description": "The model used when a request does not choose one"
          },
          "models": {
            "items": {
              "type": "string",
              "enum": [
                "baseline",
                "improved"
              ]
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "parameters",
          "model",
          "models"
        ],
        "title": "HealthResponse"
      },
      "MarkedAnswerRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/StateModel"
          },
          "concept_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Concept Tags"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "The trainer's mark as a share of the question's points"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt Number",
            "default": 1
          },
          "now": {
            "type": "integer",
            "title": "Now",
            "default": 0
          },
          "learner_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Id",
            "description": "With storage on: load this learner's saved state when `state` is empty, and save the result"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "With storage on: a resent request with the same id for the same learner returns the saved response instead of being applied twice"
          }
        },
        "type": "object",
        "required": [
          "state",
          "concept_tags",
          "score"
        ],
        "title": "MarkedAnswerRequest"
      },
